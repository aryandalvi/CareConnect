# CareConnect AI - Environment Variables
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL default for production, SQLite supported for zero-setup local dev)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/careconnect_ai?schema=public"

# AWS Credentials and Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock Configuration
# Supported models: anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.nova-pro-v1:0, anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS End User Messaging Social (WhatsApp Business Account)
AWS_WHATSAPP_PHONE_NUMBER_ID=
AWS_WHATSAPP_WABA_ID=

# AWS End User Messaging SMS
AWS_SMS_ORIGINATION_IDENTITY=

# Amazon Simple Email Service (SES)
AWS_SES_FROM_EMAIL=appointments@careconnect.health
AWS_SES_CONFIGURATION_SET=

# Application Security & Webhooks
DASHBOARD_API_KEY=careconnect-demo-key-2025
WEBHOOK_SECRET=careconnect-webhook-secret-token

# Clinic Configuration
CLINIC_NAME=CareConnect Community Health Clinic
CLINIC_PHONE=+18005550199
CLINIC_TIMEZONE=America/New_York
