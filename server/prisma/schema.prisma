// Prisma Schema for CareConnect AI - AWS CDS Hackathon
// Provider: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
  WEB_SIMULATOR
}

enum ConsentStatus {
  CONSENTED
  REVOKED
  PENDING
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  SKIPPED
}

enum SenderType {
  PATIENT
  AGENT
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum NotificationType {
  REMINDER
  CONFIRMATION
  RESCHEDULE_NOTICE
  CANCELLATION_NOTICE
  VERIFICATION
}

model Patient {
  id               String               @id @default(uuid())
  firstName        String
  lastName         String
  email            String               @unique
  phoneNumber      String               @unique
  dateOfBirth      String?              // YYYY-MM-DD for identity verification
  preferredChannel Channel              @default(WHATSAPP)
  consentStatus    ConsentStatus        @default(CONSENTED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  appointments     Appointment[]
  conversations    Conversation[]
  notifications    Notification[]
  consents         CommunicationConsent[]

  @@index([phoneNumber])
  @@index([email])
}

model Doctor {
  id             String               @id @default(uuid())
  name           String
  specialty      String
  email          String               @unique
  phone          String?
  roomNumber     String?
  bio            String?
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  availabilities DoctorAvailability[]
  appointments   Appointment[]

  @@index([specialty])
}

model DoctorAvailability {
  id                  String   @id @default(uuid())
  doctorId            String
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime           String   // HH:mm (e.g. "09:00")
  endTime             String   // HH:mm (e.g. "17:00")
  slotDurationMinutes Int      @default(30)
  active              Boolean  @default(true)

  @@index([doctorId, dayOfWeek])
}

model Appointment {
  id             String            @id @default(uuid())
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  specialty      String
  dateTime       DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  notes          String?
  reminderStatus ReminderStatus    @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  reminders      Reminder[]
  notifications  Notification[]

  @@index([doctorId, dateTime])
  @@index([patientId])
  @@index([status])
  @@index([dateTime])
}

model Conversation {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel        Channel      @default(WHATSAPP)
  status         String       @default("ACTIVE") // ACTIVE, CLOSED
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages       Message[]

  @@index([patientId])
  @@index([channel])
}

model Message {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType        SenderType
  content           String
  channel           Channel      @default(WHATSAPP)
  externalMessageId String?
  status            String       @default("DELIVERED") // SENT, DELIVERED, READ, FAILED
  metadata          String?      // JSON string for tool calls, latency, Bedrock token usage
  createdAt         DateTime     @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Notification {
  id                String             @id @default(uuid())
  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId     String?
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  channel           Channel
  type              NotificationType
  status            NotificationStatus @default(PENDING)
  recipient         String             // Phone number or email address
  subject           String?
  content           String
  externalMessageId String?            // AWS MessageId or SES MessageId
  errorMessage      String?
  retryCount        Int                @default(0)
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@index([channel])
}

model Reminder {
  id            String         @id @default(uuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  scheduledFor  DateTime
  channel       Channel        @default(WHATSAPP)
  status        ReminderStatus @default(PENDING)
  sentAt        DateTime?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([scheduledFor, status])
  @@index([appointmentId])
}

model CommunicationConsent {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  channel     Channel
  consented   Boolean  @default(true)
  consentDate DateTime @default(now())
  source      String   @default("WEB") // WEB, WHATSAPP, SMS, CLINIC_FORM
  notes       String?
  updatedAt   DateTime @updatedAt

  @@unique([patientId, channel])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String?
  performedBy String   @default("SYSTEM") // USER, AGENT, SYSTEM, ADMIN
  details     String?  // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
